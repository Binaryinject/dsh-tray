<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One TFM per host OS: builds on Windows target net9.0-windows, on macOS net9.0-macos. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net9.0-macos</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>dsh-tray</AssemblyName>
    <RootNamespace>DshTray</RootNamespace>
    <Version>0.1.0</Version>

    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Windows: NativeAOT (fully native binary, no runtime). macOS AppKit does not
       support NativeAOT yet, so it falls back to a self-contained JIT build. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
    <EmbeddedResource Include="icon.png" LogicalName="icon.png" />
  </ItemGroup>

</Project>
